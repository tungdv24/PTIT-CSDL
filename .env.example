# Copy to .env then set your own values. .env is git-ignored (never committed).
# Docker Compose reads this file automatically.

# MySQL password (used for root + the office_admin user)
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=QuanLyToaNha

# Flask session secret - generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Default admin account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
