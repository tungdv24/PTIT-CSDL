# Copy to .env then set your own values. .env is git-ignored (never committed).
# Docker Compose reads this file automatically.

# --- MySQL (business data) ---
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=QuanLyToaNha

# --- MongoDB (activity logs) ---
MONGO_USER=admin
MONGO_PASSWORD=change-this-mongo-password
MONGO_DB=quanlytoanha_logs
LOG_TTL_DAYS=90

# Mongo Express web UI (basic auth) - http://localhost:8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-this-mongo-express-password

# --- Flask app ---
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# Default admin account created on first run (demo convention: password = username)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
